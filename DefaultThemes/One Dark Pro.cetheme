{
  "name": "one-dark-pro",
  "displayName": "One Dark Pro",
  "description": "One Dark Pro with the same symbol role hierarchy as One Dark Pro Darker (locals, parameters, fields, globals, namespaces, macros, primitives).",
  "author": "CodeEdit",
  "version": "0.0.2",
  "license": "MIT",
  "distributionURL": "https://github.com/CodeEditApp/CodeEdit",
  "type": "dark",
  "editor": {
    "background": {
      "color": "#282C34"
    },
    "selection": {
      "color": "#3E4451"
    },
    "insertionPoint": {
      "color": "#528BFF"
    },
    "lineHighlight": {
      "color": "#2C313C"
    },
    "invisibles": {
      "color": "#3B4048"
    },
    "text": {
      "color": "#ABB2BF"
    },
    "comments": {
      "color": "#5C6370"
    },
    "strings": {
      "color": "#98C379"
    },
    "characters": {
      "color": "#98C379"
    },
    "numbers": {
      "color": "#D19A66"
    },
    "keywords": {
      "color": "#C678DD",
      "bold": false
    },
    "attributes": {
      "color": "#D19A66"
    },
    "types": {
      "color": "#E5C07B"
    },
    "variables": {
      "color": "#8EA6D1"
    },
    "commands": {
      "color": "#61AFEF"
    },
    "values": {
      "color": "#5FD3A8",
      "bold": true
    },
    "assignedVariables": {
      "color": "#A3BAE3"
    },
    "functions": {
      "color": "#61AFEF"
    },
    "properties": {
      "color": "#E5737D"
    },
    "parameters": {
      "color": "#B0A4E3"
    },
    "globals": {
      "color": "#5FD3A8"
    },
    "namespaces": {
      "color": "#E8B08C"
    },
    "macros": {
      "color": "#E58BB5"
    },
    "preprocessors": {
      "color": "#9B8EC4"
    },
    "primitiveTypes": {
      "color": "#56B6C2"
    }
  },
  "terminal": {
    "background": {
      "color": "#282C34"
    },
    "selection": {
      "color": "#3E4451"
    },
    "cursor": {
      "color": "#528BFF"
    },
    "text": {
      "color": "#ABB2BF"
    },
    "boldText": {
      "color": "#ABB2BF"
    },
    "black": {
      "color": "#3F4451"
    },
    "red": {
      "color": "#E05561"
    },
    "green": {
      "color": "#8CC265"
    },
    "yellow": {
      "color": "#D18F52"
    },
    "blue": {
      "color": "#4AA5F0"
    },
    "magenta": {
      "color": "#C162DE"
    },
    "cyan": {
      "color": "#42B3C2"
    },
    "white": {
      "color": "#D7DAE0"
    },
    "brightBlack": {
      "color": "#4F5666"
    },
    "brightRed": {
      "color": "#FF616E"
    },
    "brightGreen": {
      "color": "#A5E075"
    },
    "brightYellow": {
      "color": "#F0A45D"
    },
    "brightBlue": {
      "color": "#4DC4FF"
    },
    "brightMagenta": {
      "color": "#DE73FF"
    },
    "brightCyan": {
      "color": "#4CD1E0"
    },
    "brightWhite": {
      "color": "#E6E6E6"
    }
  }
}
