{
  "name": "one-dark-pro-darker",
  "displayName": "One Dark Pro Darker",
  "description": "One Dark Pro with a darker #23272E background; chrome derives from the editor background. The terminal palette mirrors the editor tokens.",
  "author": "CodeEdit",
  "version": "0.0.2",
  "license": "MIT",
  "distributionURL": "https://github.com/CodeEditApp/CodeEdit",
  "type": "dark",
  "editor": {
    "background": {
      "color": "#23272E"
    },
    "selection": {
      "color": "#3D4555"
    },
    "insertionPoint": {
      "color": "#528BFF"
    },
    "lineHighlight": {
      "color": "#2C313C"
    },
    "invisibles": {
      "color": "#3B4048"
    },
    "text": {
      "color": "#ABB2BF"
    },
    "comments": {
      "color": "#7F848E",
      "italic": true
    },
    "strings": {
      "color": "#98C379"
    },
    "characters": {
      "color": "#98C379"
    },
    "numbers": {
      "color": "#D19A66"
    },
    "keywords": {
      "color": "#C678DD"
    },
    "attributes": {
      "color": "#D19A66"
    },
    "types": {
      "color": "#E5C07B"
    },
    "variables": {
      "color": "#E06C75"
    },
    "assignedVariables": {
      "color": "#56B6C2"
    },
    "functions": {
      "color": "#61AFEF"
    },
    "commands": {
      "color": "#61AFEF"
    },
    "values": {
      "color": "#E5C07B",
      "bold": true
    },
    "operators": {
      "color": "#D7DAE0"
    }
  },
  "terminal": {
    "background": {
      "color": "#23272E"
    },
    "selection": {
      "color": "#3D4555"
    },
    "cursor": {
      "color": "#528BFF"
    },
    "text": {
      "color": "#ABB2BF"
    },
    "boldText": {
      "color": "#D7DAE0"
    },
    "black": {
      "color": "#3F4451"
    },
    "red": {
      "color": "#E06C75"
    },
    "green": {
      "color": "#98C379"
    },
    "yellow": {
      "color": "#E5C07B"
    },
    "blue": {
      "color": "#61AFEF"
    },
    "magenta": {
      "color": "#C678DD"
    },
    "cyan": {
      "color": "#56B6C2"
    },
    "white": {
      "color": "#ABB2BF"
    },
    "brightBlack": {
      "color": "#7F848E"
    },
    "brightRed": {
      "color": "#FF616E"
    },
    "brightGreen": {
      "color": "#A5E075"
    },
    "brightYellow": {
      "color": "#D19A66"
    },
    "brightBlue": {
      "color": "#4DC4FF"
    },
    "brightMagenta": {
      "color": "#DE73FF"
    },
    "brightCyan": {
      "color": "#4CD1E0"
    },
    "brightWhite": {
      "color": "#E6E6E6"
    }
  }
}
