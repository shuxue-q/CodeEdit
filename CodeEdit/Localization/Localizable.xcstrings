    },
    "CodeEdit can help identify invisible or ambiguous characters, such as zero-width spaces, directional quotes, and more. These will appear with a red block highlighting them. You can disable characters or add more here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeEdit 可帮助识别不可见或有歧义的字符，例如零宽空格、方向引号等。它们会以红色方块高亮显示。您可以在此停用字符或添加更多字符。"
          }
        }
      }
    },
    "CodeEdit cannot open this file because its file type is not supported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeEdit 无法打开此文件，因为不支持该文件类型。"
          }
        }
      }
    },
    "CodeEdit does not install language servers itself. Servers installed on your system are detected automatically and provide completion, hover, and more." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeEdit 本身不会安装语言服务器。系统中已安装的服务器会被自动检测，并提供补全、悬停提示等功能。"
          }
        }
      }
    },
    "CodeEdit is fetching changes and updating the status of files in the local repository." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeEdit 正在获取更改并更新本地仓库中文件的状态。"
          }
        }
      }
    },
    "CodeEdit supports integrating with common shells such as Bash and Zsh. This enables features like terminal title detection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeEdit 支持与 Bash 和 Zsh 等常见 Shell 集成，从而启用终端标题检测等功能。"
          }
        }
      }
    },
